# Copy to .env and fill in. NEVER commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# gemini | none. Gemini is only used for the Edit & Ask cross-check.
LLM_PROVIDER=gemini
# Leave unset: the agent loop is rules-driven. Set to gemini only to experiment with an LLM planner (npm run test:tc:llm does).
AGENT_PLANNER=
# playwright | http | auto
READER_MODE=auto
# Optional ISO date override for "today" (Asia/Kolkata), e.g. 2026-10-21
DEMO_NOW=
# Server-side secret used to HMAC login PINs (the PIN itself is never stored). Use a long random string.
# On Render this is generated for you. If it is empty in production a temporary random secret is used (new PINs die on restart).
PIN_SECRET=
PORT=3000
